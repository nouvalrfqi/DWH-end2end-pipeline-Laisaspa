# ==================================================
# Environment Configuration (copy to .env and fill in)
# .env is ignored by git. NEVER commit real secrets.
# ==================================================

# ----- Supabase / PostgreSQL (OLTP source) -----
# REST API URL, e.g. https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_URL=your_supabase_url

# Service role key for Supabase REST access (keep secret)
NEXT_PUBLIC_SUPABASE_SERVICE_ROLE_KEY=your_service_role_key

# Direct PostgreSQL connection (psycopg2).
# Get the real host/port from Supabase Dashboard -> Settings -> Database
# -> Connection string. Example host: aws-0-<region>.pooler.supabase.com
SUPABASE_HOST=your_supabase_postgres_host
SUPABASE_PORT=5432
SUPABASE_DATABASE=postgres
SUPABASE_USERNAME=postgres
SUPABASE_PASSWORD=your_db_password

# ----- AWS S3 (Data Lake) -----
AWS_ACCESS_KEY_ID=your_aws_access_key_id
AWS_SECRET_ACCESS_KEY=your_aws_secret_access_key
AWS_REGION=ap-southeast-1
AWS_BUCKET_NAME=spa-data-platform-dev
