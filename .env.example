# ==================================================
# Environment Configuration (copy to .env and fill in)
# .env is ignored by git. NEVER commit real secrets.
# ==================================================

# ----- Supabase / PostgreSQL (OLTP source) -----
# REST API URL, e.g. https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_URL=your_supabase_url

# Service role key for Supabase REST access (keep secret)
NEXT_PUBLIC_SUPABASE_SERVICE_ROLE_KEY=your_service_role_key

# Session pooler connection (psycopg2). Copy the exact host from
# Supabase Dashboard -> Settings -> Database -> Connection string.
# Host example: aws-1-ap-southeast-2.pooler.supabase.com
# Username format for pooler: <db_user>.<project_ref>, e.g. postgres.abcdefghijklm
# Port 5432 = session mode, 6543 = transaction mode.
SUPABASE_HOST=your_pooler_host.pooler.supabase.com
SUPABASE_PORT=5432
SUPABASE_DATABASE=postgres
SUPABASE_USERNAME=postgres.your_project_ref
SUPABASE_PASSWORD=your_db_password

# ----- AWS S3 (Data Lake) -----
AWS_ACCESS_KEY_ID=your_aws_access_key_id
AWS_SECRET_ACCESS_KEY=your_aws_secret_access_key
AWS_REGION=ap-southeast-1
AWS_BUCKET_NAME=spa-data-platform-dev

# ----- Snowflake (Data Warehouse) -----
# SNOWFLAKE_ACCOUNT = account identifier, e.g. <orgname>-<accountname> from the
# Snowflake URL: https://<orgname>-<accountname>.snowflakecomputing.com
SNOWFLAKE_ACCOUNT=your_account_identifier
SNOWFLAKE_USERNAME=your_snowflake_username
SNOWFLAKE_PASSWORD=your_snowflake_password
SNOWFLAKE_ROLE=your_snowflake_role
SNOWFLAKE_WAREHOUSE=SPA_WH
SNOWFLAKE_DATABASE=SPA_ANALYTICS
SNOWFLAKE_SCHEMA=STAGING
